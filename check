#!/bin/sh
# Repo gate — docs-only check now that the repo carries real content
# (profile/README.md, root README.md, profile/assets/*.svg). Extend ME
# as content grows. Hook = CI = this file (repo-gates-and-hooks parity
# rule).
set -e

echo "check: shell syntax"
find . -name '*.sh' -not -path './.git/*' -exec sh -n {} +

echo "check: markdown fenced code blocks balanced"
for f in $(find . -name '*.md' -not -path './.git/*'); do
  count=$(grep -c '^```' "$f" || true)
  if [ $((count % 2)) -ne 0 ]; then
    echo "check: FAILED - unbalanced fenced code block in $f" >&2
    exit 1
  fi
done

echo "check: markdown relative links resolve"
for f in $(find . -name '*.md' -not -path './.git/*'); do
  dir=$(dirname "$f")
  targets=$(grep -o '\]([^)]*)' "$f" | sed 's/^](//; s/)$//')
  for target in $targets; do
    case "$target" in
      http://*|https://*|mailto:*|"#"*) continue ;;
    esac
    path="${target%%#*}"
    if [ -n "$path" ] && [ ! -e "$dir/$path" ]; then
      echo "check: FAILED - broken relative link '$target' in $f" >&2
      exit 1
    fi
  done
done

echo "check: markdown picture/srcset relative targets resolve"
for f in $(find . -name '*.md' -not -path './.git/*'); do
  dir=$(dirname "$f")
  targets=$(grep -o 'srcset="[^"]*"' "$f" | sed 's/^srcset="//; s/"$//')
  targets="$targets $(grep -o '<img[^>]*src="[^"]*"' "$f" | sed 's/.*src="//; s/"$//')"
  for target in $targets; do
    case "$target" in
      ""|http://*|https://*) continue ;;
    esac
    if [ ! -e "$dir/$target" ]; then
      echo "check: FAILED - broken picture/img target '$target' in $f" >&2
      exit 1
    fi
  done
done

echo "check: SVG assets are well-formed and self-contained"
if command -v xmllint >/dev/null 2>&1; then
  for f in $(find . -name '*.svg' -not -path './.git/*'); do
    xmllint --noout "$f" || { echo "check: FAILED - $f is not well-formed XML" >&2; exit 1; }
    if grep -qiE 'foreignObject|<script|javascript:|(href|src)="https?://' "$f"; then
      echo "check: FAILED - $f references external content or scripting (must be pure shapes/text)" >&2
      exit 1
    fi
  done
else
  echo "check: SKIPPED - xmllint not installed"
fi

echo "check: profile stats privacy filter (fixture test)"
sh scripts/update-profile.test.sh

echo "check: green"
